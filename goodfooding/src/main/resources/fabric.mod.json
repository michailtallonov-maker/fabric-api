{
  "schemaVersion": 1,
  "id": "goodfooding",
  "version": "${version}",
  "name": "Goodfooding",
  "description": "Client-side goodfooding: detach the view from your player and fly through walls. Works on any server.",
  "authors": ["michailtallonov"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.github.michailtallonov.goodfooding.GoodfoodingClient"
    ]
  },
  "mixins": [
    "goodfooding.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~${minecraft_version}",
    "fabric-api": "*"
  }
}
